  "prompt_templates": {
    "baseline": "请回答以下关于汉字的问题：\n\n问题：{question}\n\n目标字：{character}",
    "pinyin_only": "请回答以下关于汉字的问题：\n\n目标字：{character}（读音{pinyin}）\n\n问题：{question}\n\n提示：这个字的读音是{pinyin}。",
    "radical_only": "请回答以下关于汉字的问题：\n\n目标字：{character}（部首：{radical}）\n\n问题：{question}\n\n提示：这个字的部首是'{radical}'，在汉字中，部首通常提示字义类别。",
    "full_enhanced": "请回答以下关于汉字的问题：\n\n目标字：{character}（部首：{radical}，声旁：{phonetic}，读音：{pinyin}）\n\n问题：{question}\n\n提示：\n1. 部首'{radical}'通常与{radical_hint}有关\n2. 声旁'{phonetic}'提示读音可能与{phonetic_pinyin}相近\n3. 这是一个形声字，形旁表意，声旁表音",
    "expert_mode": "你是一个汉字学专家。请利用形声字的构字规律回答以下问题。\n\n目标字：{character}\n结构分析：\n- 部首（形旁）：{radical} → 表示与{radical_meaning}相关\n- 声旁（声部）：{phonetic} → 提示读音为{pinyin}\n\n问题：{question}"
  },
  "evaluation_criteria": {
    "semantic_inference": [
      "回答是否提到了部首对应的语义类别",
      "回答是否有合理的推理过程",
      "回答是否准确（与标准答案匹配度）"
    ],
    "pronunciation_inference": [
      "是否正确识别声旁",
      "读音推断是否合理",
      "是否解释了推断依据"
    ],
    "reasoning_quality": [
      "是否使用了部首信息",
      "是否使用了声旁信息",
      "推理是否逻辑清晰"
    ]
  }
}